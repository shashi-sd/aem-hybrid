<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Navigation Panel"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Properties"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <panels
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldDescription="Define Navigation Panels."
                                                    fieldLabel="Panels">
                                                <field
                                                        granite:class="cmp-options--editor-item-multifield-composite-item coral-Well"
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./panels">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <option
                                                                granite:class="cmp-options--editor-item-multifield-composite-item-container"
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <heading
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                        fieldDescription="Heading"
                                                                        fieldLabel="Heading"
                                                                        name="./heading"/>
                                                                <links
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                                        composite="{Boolean}true"
                                                                        fieldDescription="Define Navigation Links."
                                                                        fieldLabel="Links">
                                                                    <field
                                                                            granite:class="cmp-options--editor-item-multifield-composite-item coral-Well"
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                            name="./links">
                                                                        <items jcr:primaryType="nt:unstructured">
                                                                            <option
                                                                                    granite:class="cmp-options--editor-item-multifield-composite-item-container"
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                <items jcr:primaryType="nt:unstructured">
                                                                                    <label
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                            fieldLabel="Link Label"
                                                                                            required="{Boolean}true"
                                                                                            name="./label"/>
                                                                                    <url
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                                            fieldDescription="Selection for URL page path."
                                                                                            fieldLabel="URL"
                                                                                            name="./url"
                                                                                            required="{Boolean}true"
                                                                                            deleteHint="{Boolean}true"
                                                                                            rootPath="/content/aem-hybrid-calix"/>
                                                                                    <target
                                                                                            granite:class="cmp-link-target"
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                                            fieldDescription="If checked the link will be opened in a new browser tab."
                                                                                            name="./target"
                                                                                            text="Open link in new tab"
                                                                                            uncheckedValue="_self"
                                                                                            value="_blank"/>
                                                                                </items>
                                                                            </option>
                                                                        </items>
                                                                    </field>
                                                                </links>
                                                            </items>
                                                        </option>
                                                    </items>
                                                </field>
                                            </panels>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                    <bottomLinks
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Bottom Links"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <bottom-links
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldDescription="Define Bottom Links on this Panel."
                                                    fieldLabel="Bottom Links">
                                                <field
                                                        granite:class="cmp-options--editor-item-multifield-composite-item coral-Well"
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./bottomLinks">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <option
                                                                granite:class="cmp-options--editor-item-multifield-composite-item-container"
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <label
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                        fieldLabel="Link Label"
                                                                        required="{Boolean}true"
                                                                        name="./label"/>
                                                                <url
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                        fieldDescription="Selection for URL page path."
                                                                        fieldLabel="URL"
                                                                        name="./url"
                                                                        required="{Boolean}true"
                                                                        deleteHint="{Boolean}true"
                                                                        rootPath="/content/aem-hybrid-calix"/>
                                                                <target
                                                                        granite:class="cmp-link-target"
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                        fieldDescription="If checked the link will be opened in a new browser tab."
                                                                        name="./target"
                                                                        text="Open link in new tab"
                                                                        uncheckedValue="_self"
                                                                        value="_blank"/>
                                                            </items>
                                                        </option>
                                                    </items>
                                                </field>
                                            </bottom-links>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </bottomLinks>
                    <variation-fragment-section
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Experience Fragment"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <fragmentVariationPath
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/experience-fragments/editor/components/xffield"
                                                    granite:id="xfPicker"
                                                    name="./fragmentVariationPath"
                                                    fieldLabel="Variation"
                                                    filter="folderOrVariant"
                                                    propertyFilter="cq:xfShowInEditor"
                                                    variant="web"
                                                    fieldDescription="Choose the experience fragment variation to display.">
                                            </fragmentVariationPath>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </variation-fragment-section>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>