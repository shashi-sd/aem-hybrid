<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="User Auth Control"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <greetingPrefix
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Greeting Prefix"
                                                fieldDescription="Shown before the username, e.g. 'Hi,' renders 'Hi, jdoe'."
                                                name="./greetingPrefix"
                                                value="Hi,"/>
                                            <showHomeIcon
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Show Home Icon"
                                                fieldDescription="Displays a Home icon link before the greeting."
                                                name="./showHomeIcon"
                                                value="{Boolean}true"
                                                checked="{Boolean}true"/>
                                            <homeUrl
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Home URL"
                                                fieldDescription="Page the Home icon links to. Defaults to the site home page."
                                                name="./homeUrl"
                                                rootPath="/content"/>
                                            <homeLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Home Label / Aria Label"
                                                name="./homeLabel"
                                                value="Home"/>
                                            <loginUrl
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Login URL"
                                                fieldDescription="Shown to anonymous users. Defaults to the site login page."
                                                name="./loginUrl"
                                                rootPath="/content"/>
                                            <loginLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Login Label"
                                                name="./loginLabel"
                                                value="Login"/>
                                            <logoutUrl
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Logout URL (override)"
                                                fieldDescription="Optional. If left blank, the AEM Sling logout URL is built from the Post-Logout Redirect below (/system/sling/logout.html?resource=&lt;redirect&gt;)."
                                                name="./logoutUrl"/>
                                            <logoutRedirectPath
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Post-Logout Redirect"
                                                fieldDescription="Page users land on after logout (used when Logout URL override is blank)."
                                                name="./logoutRedirectPath"
                                                rootPath="/content"/>
                                            <logoutLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Logout Label"
                                                name="./logoutLabel"
                                                value="Logout"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
