{
    "compilerOptions": {
        "target": "es5",
        "module": "es6",
        "baseUrl": "src",
        "paths": {
            "@calix/*": ["../../site/scripts/*"],
            "@components/*": ["../../site/scripts/components/*"],
            "@styles/*": ["../../site/styles/utils/variables/*"]
        },
        "removeComments": true,
        "allowJs": true,
        "preserveConstEnums": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true
    },
    "include": [ "./src/**/*.ts" ]
}
